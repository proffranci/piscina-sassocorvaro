# Copia questi nomi nelle "Environment Variables" di Vercel.
# I valori li trovi in Supabase > Project Settings > API Keys (e Data API per l'URL).

# Indirizzo del progetto Supabase (pubblico)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co

# Chiave "publishable" (o "anon"): pubblica, protetta dalla Row Level Security
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Chiave "secret" (o "service_role"): SEGRETA, solo lato server.
# Serve allo staff per creare gli account dei clienti. Mai nel codice, mai su GitHub.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx
